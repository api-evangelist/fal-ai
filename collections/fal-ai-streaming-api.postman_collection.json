          "name": "Stream Model Inference Output",
          "request": {
            "name": "Stream Model Inference Output",
            "description": {
              "content": "Synchronous streaming endpoint that emits Server-Sent Events as the model produces progressive output (tokens, intermediate frames, diffusion steps). Useful for chatty multimodal models and live previews.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                ":model_owner",
                ":model_name",
                "stream"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "model_owner",
                  "description": "(Required) Owning organization of the model (e.g. `fal-ai`, `black-forest-labs`)."
                },
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "model_name",
                  "description": "(Required) Model identifier (e.g. `flux/schnell`, `kling-2.5/text-to-video`, `veo-3`)."
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
