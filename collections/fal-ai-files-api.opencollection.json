{
  "opencollection": "1.0.0",
  "info": {
    "name": "fal Model APIs Apps Files API",
    "version": "v1"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Files",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List Serverless Files",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://queue.fal.run/serverless/files",
            "params": [
              {
                "name": "path",
                "value": "",
                "type": "query",
                "description": "Subdirectory path under `/data` to list."
              }
            ]
          },
          "docs": "List files on the persistent `/data` volume mounted into Serverless runs."
        }
      ]
    }
  ],
  "bundled": true
}